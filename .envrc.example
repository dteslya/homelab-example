export TF_VAR_incus_token=xxx
export ARGOCD_PASSWORD=$(kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath="{.data.password}" | base64 -d)
export ANSIBLE_VAULT_PASSWORD_FILE=$PWD/ansible/.vault_pass
# OpenTofu state on B2 (bucket-scoped application key) + state encryption passphrase
export AWS_ACCESS_KEY_ID=xxx
export AWS_SECRET_ACCESS_KEY=xxx
export TF_VAR_state_passphrase=xxx
# TrueNAS API key for the truenas/ stack (README.md → TrueNAS settings)
export TF_VAR_truenas_api_key=xxx
# Vaultwarden item that holds the tfstate copies (scripts/backup-tfstate.sh)
export BW_TFSTATE_ITEM_ID=xxx
