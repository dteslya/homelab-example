# Example of vault.yml, an ansible-vault encrypted file. Copy it to vault.yml,
# fill in the values, then run: ansible-vault encrypt vault.yml
# Keys are the vault_* variables referenced by the files in this directory.
---
vault_gatus_heartbeat_token: CHANGE_ME
vault_openwrt_acme_cf_token: CHANGE_ME
vault_openwrt_wifi_psk: CHANGE_ME
