{{ ansible_managed | comment }}
# Public URL clients connect to. TLS is terminated by Caddy in front of
# this, so headscale itself only ever speaks plain HTTP on localhost.
server_url: https://{{ headscale_domain }}

listen_addr: {{ headscale_listen_addr }}
metrics_listen_addr: {{ headscale_metrics_listen_addr }}
grpc_listen_addr: {{ headscale_grpc_listen_addr }}
grpc_allow_insecure: false

# Caddy reverse-proxies from localhost, so trust its forwarded headers.
trusted_proxies:
  - 127.0.0.1/32

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: {{ headscale_embedded_derp_enabled | lower }}
    region_id: 999
    region_code: "headscale"
    region_name: "Headscale Embedded DERP"
    stun_listen_addr: "0.0.0.0:3478"
    private_key_path: /var/lib/headscale/derp_server_private.key
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  paths: []
  auto_update_enabled: true
  update_frequency: 24h

disable_check_updates: false

node:
  expiry: 0
  ephemeral:
    inactivity_timeout: 5m
  routes:
    ha:
      probe_interval: 10s
      probe_timeout: 5s

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true
    wal_autocheckpoint: 1000

# TLS is handled entirely by Caddy (Cloudflare DNS-01), so headscale's
# own ACME/cert options stay empty/disabled.
acme_url: https://acme-v02.api.letsencrypt.org/directory
acme_email: ""
tls_letsencrypt_hostname: ""
tls_letsencrypt_cache_dir: /var/lib/headscale/cache
tls_cert_path: ""
tls_key_path: ""

log:
  level: info
  format: text

{% if headscale_manage_policy %}
policy:
  mode: file
  path: /etc/headscale/policy.hujson
{% endif %}

dns:
  magic_dns: true
  base_domain: {{ headscale_dns_base_domain }}
  override_local_dns: true
  nameservers:
    global:
      - 1.1.1.1
      - 1.0.0.1
    split: {}
  search_domains: []
  extra_records: []

unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

logtail:
  enabled: false

taildrop:
  enabled: true

auto_update:
  enabled: false
