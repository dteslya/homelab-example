    'ra_flags': ['managed-config', 'other-config'], 'ignore': true}) -}}
{{ section('odhcpd', 'odhcpd', {'maindhcp': false, 'leasefile': '/tmp/odhcpd.leases', 'leasetrigger': '/usr/sbin/odhcpd-update', 'loglevel': 4,
