<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs paperless-mirror.sh daily at 06:00 local time and at login. A run
  missed while the Mac was asleep fires on wake. Install:
    cp scripts/mac/paperless-mirror.sh ~/bin/
    cp scripts/mac/com.example.paperless-mirror.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.paperless-mirror.plist
  Replace USERNAME below with your macOS short name first.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.paperless-mirror</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/bin/paperless-mirror.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/paperless-mirror.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/paperless-mirror.log</string>
</dict>
</plist>
